# Dhanwanthari clinic system — settings. Copy to .env (project root) and edit.
# Used by Docker (docker compose) and by the server without Docker (scripts/start.sh, systemd).
# One setting per line, NAME=value. Put a value in "double quotes" if it has spaces or a $ sign. Comments on their own line.

# ---------------------------------------------------------------- server
APP_ENV=production
# 64+ random characters each. Make them with:  openssl rand -hex 32
JWT_SECRET=change-me-run-openssl-rand-hex-32
OTP_PEPPER=change-me-run-openssl-rand-hex-32
# Port the server listens on (Caddy / nginx forward to it)
PORT=8080
# Your web address (Docker: Caddy gets the HTTPS certificate for it)
DOMAIN=medical.levinova-ai.com

# ---------------------------------------------------------------- first admin login
# Created on the first start only, if no user with this email exists. Sign in, then change the password
# (key button at the top right). Add the other staff in Administration.
ADMIN_EMAIL=admin@dhanwanthari.test
ADMIN_PASSWORD=Dhanwanthari@2026

# ---------------------------------------------------------------- email (Amazon SES)
# log = nothing is sent; codes and emails are printed in the server console (use until SES is set up).
# ses = send through Amazon SES (see README → "Email with Amazon SES").
EMAIL_PROVIDER=log
AWS_REGION=ap-southeast-5
# IAM user keys (leave empty when the server runs on AWS with an IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Sender: an address or domain verified in SES — add later
SES_FROM_EMAIL=
SES_FROM_NAME="Dhanwanthari Vilasam"
SES_REPLY_TO=
# Optional SES configuration set (bounce / complaint tracking)
SES_CONFIGURATION_SET=
# Email the invoice when a visit is finished (on/off). Receipts are always emailed after payment.
INVOICE_EMAILS=on
# Production only, while email is not set up: print sign-in codes in the server log (log) or not at all (empty)
OTP_DELIVERY=log

# ---------------------------------------------------------------- optional
# Session length in hours
SESSION_HOURS=8
# What the web app is told at /config.json: live | auto | demo
FRONTEND_MODE=live
# Only if the web app is served from a different domain (comma separated)
ALLOWED_ORIGINS=
# Without Docker the database is dhanwanthari-server/data/clinic.db. Docker: /app/data/clinic.db (./data on the host).
# DATABASE_URL=sqlite:////opt/dhanwanthari/dhanwanthari-server/data/clinic.db
